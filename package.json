{
  "name": "hs-audit-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "test:smoke": "node scripts/smoke.cjs",
    "build:pages": "vite build --mode demo --base=/H-S-App/ --outDir=dist-pages",
    "publish:pages": "bash scripts/publish-pages.sh",
    "start": "node --use-env-proxy --env-file-if-exists=.env server/index.js",
    "dev:server": "node --use-env-proxy --watch server/index.js",
    "build:demo": "vite build --mode demo",
    "test:accounts": "node scripts/accounts-smoke.mjs",
    "setup:stripe": "node --use-env-proxy --env-file-if-exists=.env scripts/setup-stripe.mjs",
    "test:ppe": "node scripts/ppe-smoke.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "stripe": "^23.0.0"
  },
  "engines": {
    "node": ">=24.5.0"
  }
}
